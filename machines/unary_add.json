        [
            { "read" : "1", "to_state": "findplus", "write": "1", "action": "RIGHT"},
            { "read" : "+", "to_state": "readright", "write": ".", "action": "RIGHT"}
        ],
        "readright":
        [
            { "read" : "1", "to_state": "fillgap", "write": "1", "action": "LEFT"},
            { "read" : "=", "to_state": "HALT", "write": ".", "action": "LEFT"}
        ],
        "fillgap":
